  "productName": "Luke-Share",
  "version": "0.2.0",
  "identifier": "dev.lukeshare.stream",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luke-Share",
